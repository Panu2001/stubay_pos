{
  "name": "easy-pos-desktop",
  "version": "1.0.0",
  "description": "Desktop wrapper for EASY POS",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^26.8.1"
  },
  "build": {
    "appId": "com.easypos.app",
    "productName": "EASY POS",
    "win": {
      "target": "portable",
      "icon": "icon.ico"
    }
  }
}
